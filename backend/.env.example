PROJECT_NAME="AI Chatbot Builder"
SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# For PostgreSQL (Production): postgresql+psycopg2://user:password@localhost:5432/chatbot_db
# For local dev / testing fallback: sqlite:///./chatbot_builder.db
DATABASE_URL="sqlite:///./chatbot_builder.db"

# Phase 2: Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key-here"
EMBEDDING_MODEL="text-embedding-004"

# Phase 2: ChromaDB vector store persistence directory
CHROMA_PERSIST_DIR="./chroma_data"

# Phase 2: File upload settings
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR="./uploads"

# Phase 2: Chunking defaults
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
